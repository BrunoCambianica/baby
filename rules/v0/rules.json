{
  "id": "baby-rules",
  "version": "0.1.0",
  "status": "brouillon, à relire avant toute diffusion",
  "updated": "2026-10-21",
  "locale": "fr-FR",
  "policy": {
    "medical_advice": false,
    "official_message_levels": ["A", "A-etranger"],
    "kinds": {
      "officiel": "Repère officiel, cité avec sa source",
      "pratique": "Suggestion pratique, sans portée sanitaire",
      "fabricant": "Indication des fabricants ou d'une norme produit",
      "meteo": "Donnée météo"
    },
    "out_of_scope": [
      "fièvre, maladie, symptômes, médicaments",
      "diagnostic, triage ou réassurance sur l'état de santé de l'enfant",
      "promesse de sécurité ou de prévention de la mort inattendue du nourrisson",
      "produits présentés comme protégeant la santé"
    ]
  },
  "outing": {
    "default_window": { "from": "09:00", "to": "18:00" },
    "default_duration_h": 1,
    "vigilance": {
      "block_all_from_color": "rouge",
      "block_all_if_orange_for": [
        "vent-violent", "orages", "pluie-inondation", "crues",
        "neige-verglas", "avalanches", "vagues-submersion", "grand-froid"
      ],
      "source": "meteofrance-vigilance"
    },
    "heat": {
      "trigger_vigilance_canicule_from": "jaune",
      "trigger_tmax_c_at_least": 30,
      "blocked_hours": { "from": "11:00", "to": "21:00" },
      "source": "spf-fortes-chaleurs-bebes"
    },
    "ozone_episode_blocked_hours": { "from": "12:00", "to": "18:00", "source": "santefr-pollution" },
    "slot_exclusions": {
      "feels_c_at_most": -5,
      "precip_prob_at_least": 60,
      "precip_mm_at_least": 0.5,
      "gust_kmh_at_least": 60
    },
    "scoring": {
      "base": 100,
      "rain_prob_free": 20,
      "rain_prob_weight": 1,
      "comfort_low_c": 15,
      "comfort_low_weight": 2,
      "comfort_high_c": 24,
      "comfort_high_weight": 3,
      "gust_free_kmh": 30,
      "gust_weight": 0.5,
      "uv_free": 2,
      "uv_weight": 10,
      "uv_weight_under_12m": 20
    },
    "none_reason_priority": [
      "canicule_heures_chaudes", "ozone_apres_midi", "froid_extreme", "vent", "pluie", "duree"
    ]
  },
  "outfit": {
    "bands": [
      { "id": "tres_chaud", "min_feels_c": 27, "items": ["body_leger", "tenue_ample_claire", "chapeau"] },
      { "id": "chaud", "min_feels_c": 22, "items": ["body_mc", "tenue_legere", "chapeau_si_soleil"] },
      { "id": "doux", "min_feels_c": 18, "items": ["body_mc", "pyjama_leger", "gilet_fin"] },
      { "id": "frais", "min_feels_c": 14, "items": ["body_ml", "pyjama", "gilet"] },
