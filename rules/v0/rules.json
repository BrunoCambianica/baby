      { "id": "tres_froid", "min_feels_c": null, "items": ["body_ml", "pyjama_chaud", "pull", "combi_pilote_doublee", "bonnet", "moufles", "chaussons", "chanceliere"] }
    ],
    "transport": {
      "poussette": { "band_shift": 0, "remove_items": [], "notes": [] },
      "porte_bebe": {
        "band_shift": -1,
        "remove_items": ["chanceliere"],
        "replace_items": {
          "pyjama_leger": ["pantalon_leger", "chaussettes"],
          "pyjama": ["pantalon", "chaussettes"],
          "pyjama_chaud": ["pantalon_chaud", "chaussettes_chaudes"],
          "combi_legere": ["couverture_portage"],
          "combi_pilote": ["manteau_portage"],
          "combi_pilote_doublee": ["manteau_portage"]
        },
        "notes": ["practical.carrier.body_heat", "practical.carrier.no_footed"]
      },
      "voiture": { "band_shift": 0, "remove_items": ["chanceliere"], "notes": [] }
    },
    "overlays": {
      "rain_cover_prob_at_least": 30,
      "rain_later_prob_at_least": 50,
      "wind_gust_kmh_at_least": 40
    }
  },
