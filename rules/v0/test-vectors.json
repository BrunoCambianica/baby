      "description": "Hiver sec : on sort à l'heure la plus douce",
      "input": {
        "forecast": { "hourly": { "base": { "feels_c": 4 }, "overrides": { "12:00-15:00": { "feels_c": 7 }, "13:00": { "feels_c": 8 } } } }
