# Copier en .env sur le serveur (ce fichier .env ne va jamais dans git).
# Sous-domaine de l'API, avec un enregistrement DNS A vers le VPS :
DOMAINE=api.exemple.fr
# Seule origine autorisée à appeler l'API (l'app) :
ORIGINES=https://brunocambianica.github.io
# Adresse du site, pour les liens courts des fiches du jour :
SITE=https://brunocambianica.github.io/baby/
# Clés des notifications : docker compose run --rm api node cles-vapid.js
VAPID_PUBLIQUE=
VAPID_PRIVEE=
# Contact demandé par les services de notifications (une page ou une adresse mailto:) :
VAPID_CONTACT=https://brunocambianica.github.io/baby/
