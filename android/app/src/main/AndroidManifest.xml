<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- « Ma position » pour trouver la commune : position approximative, demandée seulement à ce moment-là. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Rappel du soir, s'il est activé dans l'app : une notification par jour au plus. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Superbebe">

        <!-- L'app web en plein écran ; le widget l'ouvre quand on le touche. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Configuration envoyée par l'app web : superbebe://config/SB1.… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="superbebe" android:host="config" />
            </intent-filter>
        </activity>

        <!-- Choix de l'enfant d'un widget, à la pose ou par « Modifier le widget ». -->
        <activity
            android:name=".SbWidgetConfigure"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Image de la fiche du jour, prêtée le temps du partage (cache de l'app). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="fr.superbebe.widget.fichiers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fichiers" />
        </provider>

        <!-- Réponse d'Android quand un widget est posé depuis l'app. -->
        <receiver
            android:name=".SbPinReceiver"
            android:exported="false" />

        <receiver
            android:name=".SbWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/superbebe_widget" />
        </receiver>
    </application>
</manifest>
