  "components": [
    {
      "name": "Bouton principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "L'action principale de l'écran, pleine largeur ; la variante d'appel porte la lueur saumon.",
      "html": "<button class=\"ds-btn ds-btn-cta\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 14l11 -11\"/><path d=\"M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5\"/></svg>Envoyer la fiche du jour</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:54px;padding:12px 22px;border:0;border-radius:999px;background:var(--accent,#f6a493);color:var(--on-accent,#5e2216);font:600 1rem/1.2 Poppins,ui-rounded,system-ui,sans-serif;width:100%;cursor:pointer;transition:transform .14s cubic-bezier(.2,.8,.2,1),box-shadow .2s ease}.ds-btn-cta{min-height:58px;box-shadow:0 14px 26px -14px rgba(240,138,116,.55)}.ds-btn:hover{box-shadow:0 18px 30px -14px rgba(240,138,116,.65)}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:3px solid var(--accent-deep,#a8432e);outline-offset:2px}"
    },
    {
      "name": "Bouton doux",
      "kind": "button",
      "refersTo": "button-soft",
      "description": "Action neutre ou secondaire, en petit format.",
      "html": "<button class=\"ds-btn-soft\">Plus tard</button> <button class=\"ds-btn-tint\">Choisir cette heure</button>",
      "css": ".ds-btn-soft,.ds-btn-tint{min-height:44px;padding:8px 16px;border:0;border-radius:999px;font:600 .9rem/1.2 Poppins,ui-rounded,system-ui,sans-serif;cursor:pointer;transition:transform .14s cubic-bezier(.2,.8,.2,1),background-color .2s ease}.ds-btn-soft{background:var(--fill,#f6f2ee);color:var(--ink,#1c1b22)}.ds-btn-tint{background:var(--accent-soft,#fde6e0);color:var(--accent-ink,#8a3f30)}.ds-btn-soft:active,.ds-btn-tint:active{transform:scale(.97)}.ds-btn-soft:focus-visible,.ds-btn-tint:focus-visible{outline:3px solid var(--accent-deep,#a8432e);outline-offset:2px}"
    },
    {
      "name": "Barre d'onglets",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "Trois onglets dans une pilule blanche flottante ; l'actif en voile saumon.",
      "html": "<nav class=\"ds-tabs\"><button aria-selected=\"true\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7\"/></svg>Journée</button><button>Nuit</button><button>Achats <span class=\"ds-badge\">3</span></button></nav>",
      "css": ".ds-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2px;padding:6px;max-width:448px;border-radius:999px;background:var(--card,#fff);border:1px solid var(--line,#efe9e4);box-shadow:0 16px 36px -14px rgba(96,62,42,.32),0 2px 8px -2px rgba(96,62,42,.08)}.ds-tabs button{display:flex;align-items:center;justify-content:center;gap:7px;min-height:48px;padding:0 8px;border:0;border-radius:999px;background:none;color:var(--ink-3,#716c77);font:500 .9rem Poppins,ui-rounded,system-ui,sans-serif;cursor:pointer;transition:background-color .2s ease,transform .14s cubic-bezier(.2,.8,.2,1)}.ds-tabs button:hover{color:var(--ink,#1c1b22)}.ds-tabs button:active{transform:scale(.96)}.ds-tabs [aria-selected=true]{background:var(--accent-soft,#fde6e0);color:var(--accent-ink,#8a3f30);font-weight:600}.ds-tabs button:focus-visible{outline:3px solid var(--accent-deep,#a8432e);outline-offset:2px}.ds-badge{display:grid;place-items:center;min-width:20px;height:20px;padding:0 5px;border-radius:999px;background:var(--badge,#c9382c);color:var(--on-badge,#fff);font-size:.7rem;font-weight:700;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Pastilles et étiquettes",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Pastille d'état « Sortie idéale », condition d'alerte, étiquette neutre.",
      "html": "<span class=\"ds-chip\">Sortie idéale</span> <span class=\"ds-cond\">Averse possible · 25 %</span> <span class=\"ds-tag\">2 à 4 ans</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;min-height:22px;padding:2px 9px;border-radius:999px;background:var(--chip-green,#cdebd6);color:var(--chip-green-ink,#1f5c3a);font:600 .68rem Poppins,ui-rounded,system-ui,sans-serif;letter-spacing:.06em;text-transform:uppercase}.ds-cond{display:inline-flex;align-items:center;min-height:30px;padding:0 11px;border-radius:999px;background:var(--amber-soft,#fdecc8);color:var(--amber,#8a5300);font:600 .8rem Poppins,ui-rounded,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-tag{display:inline-flex;align-items:center;padding:3px 9px;border-radius:999px;background:var(--fill,#f6f2ee);color:var(--ink-2,#56525c);font:500 .76rem Poppins,ui-rounded,system-ui,sans-serif}"
    },
    {
      "name": "Carte",
      "kind": "card",
      "refersTo": "card",
      "description": "La surface de contenu : blanche, 28 px, filet et ombre chaude unique.",
      "html": "<article class=\"ds-card\"><h3>Maintenant</h3><p>Jusqu'à 14 h 10</p></article>",
      "css": ".ds-card{display:grid;gap:4px;padding:18px;border-radius:28px;background:var(--card,#fff);border:1px solid var(--line,#efe9e4);box-shadow:0 14px 34px -16px rgba(96,62,42,.22),0 2px 6px -2px rgba(96,62,42,.06);font-family:Poppins,ui-rounded,system-ui,sans-serif;color:var(--ink,#1c1b22)}.ds-card h3{margin:0;font-size:1.32rem;font-weight:700;letter-spacing:-.01em}.ds-card p{margin:0;font-size:.86rem;color:var(--ink-3,#716c77)}"
    },
    {
      "name": "Carte du ciel",
      "kind": "custom",
      "refersTo": "sky-card",
      "description": "Signature : dégradé pastel, le grand nombre devant la forme météo, Ressenti en pastille blanche.",
      "html": "<section class=\"ds-sky\"><div class=\"ds-now\"><svg class=\"ds-art\" viewBox=\"0 0 200 150\"><defs><radialGradient id=\"dsun\" cx=\".36\" cy=\".3\" r=\".8\"><stop offset=\"0\" stop-color=\"#fff2ae\"/><stop offset=\".55\" stop-color=\"#ffc940\"/><stop offset=\"1\" stop-color=\"#f4971a\"/></radialGradient><linearGradient id=\"dcl\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#fff\"/><stop offset=\".6\" stop-color=\"#f1f5fb\"/><stop offset=\"1\" stop-color=\"#cdd7e7\"/></linearGradient></defs><circle cx=\"134\" cy=\"50\" r=\"31\" fill=\"url(#dsun)\"/><g fill=\"url(#dcl)\" transform=\"translate(18 36) scale(1.28)\"><circle cx=\"38\" cy=\"46\" r=\"24\"/><circle cx=\"66\" cy=\"34\" r=\"30\"/><circle cx=\"92\" cy=\"48\" r=\"22\"/><rect x=\"20\" y=\"44\" width=\"92\" height=\"28\" rx=\"14\"/></g></svg><span class=\"ds-temp\">12°</span><span class=\"ds-feels\">Ressenti 10°</span></div><button class=\"ds-fold\">Éclaircies <span>Détails et demain</span></button></section>",
      "css": ".ds-sky{position:relative;display:grid;gap:10px;padding:14px;border-radius:28px;background:linear-gradient(165deg,#cfe4fb 0%,#eef5fd 38%,#fff6ee 70%,#ffe7d6 100%);border:1px solid rgba(255,255,255,.9);box-shadow:0 14px 34px -16px rgba(96,62,42,.22),0 2px 6px -2px rgba(96,62,42,.06);font-family:Poppins,ui-rounded,system-ui,sans-serif;color:#1c1b22;max-width:360px}.ds-now{position:relative;display:flex;justify-content:center;align-items:flex-start;gap:4px;padding:64px 0 20px;isolation:isolate}.ds-art{position:absolute;z-index:-1;left:42%;top:0;width:200px}.ds-temp{font-weight:700;font-size:5rem;line-height:.84;letter-spacing:-.04em;font-variant-numeric:tabular-nums;paint-order:stroke fill;-webkit-text-stroke:.08em #f2f7fd}.ds-feels{display:inline-flex;align-items:center;min-height:38px;margin-top:12px;padding:0 15px;border-radius:999px;background:#fff;box-shadow:0 2px 6px -2px rgba(96,62,42,.18);font-weight:600;font-size:.94rem}.ds-fold{display:flex;align-items:center;justify-content:space-between;min-height:48px;padding:0 14px;border:0;border-radius:24px;background:rgba(255,255,255,.86);font:600 .95rem Poppins,ui-rounded,system-ui,sans-serif;color:#1c1b22;cursor:pointer}.ds-fold span{font-weight:400;font-size:.82rem;color:#524e59}.ds-fold:hover{background:#fff}.ds-fold:focus-visible{outline:3px solid #1c1b22;outline-offset:2px}"
    },
    {
      "name": "Tuile de vêtement",
      "kind": "custom",
      "refersTo": "garment-tile",
      "description": "Une pièce de la tenue : dessin deux tons de sa famille, nom, signe de changement.",
      "html": "<div class=\"ds-tile\"><span class=\"ds-sign\">+</span><svg width=\"64\" height=\"64\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#583796\" stroke-width=\"1.15\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><defs><linearGradient id=\"dtete\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#ece2fa\"/><stop offset=\"1\" stop-color=\"#bda1e8\"/></linearGradient></defs><path d=\"M5 15a7 7 0 0 1 14 0z\" fill=\"url(#dtete)\"/><path d=\"M4 15h16v3h-16z\" fill=\"url(#dtete)\"/></svg><span class=\"ds-tile-name\">Bonnet fin</span></div>",
      "css": ".ds-tile{position:relative;display:grid;justify-items:center;gap:5px;width:110px;padding:10px 8px;border-radius:20px;background:var(--tile,#faf8f6);border:1px solid var(--line,#efe9e4);font-family:Poppins,ui-rounded,system-ui,sans-serif;text-align:center}.ds-tile-name{font-size:.78rem;font-weight:600;line-height:1.22;letter-spacing:-.01em;color:var(--ink,#1c1b22)}.ds-sign{position:absolute;right:6px;top:6px;display:grid;place-items:center;width:18px;height:18px;border-radius:50%;background:var(--amber,#8a5300);color:var(--card,#fff);font-weight:700;font-size:.82rem;line-height:1}"
    },
    {
      "name": "Le sac",
      "kind": "card",
      "refersTo": "bag-note",
      "description": "La seule carte crème : ce qu'on emporte, posé dans la carte de la tenue.",
      "html": "<div class=\"ds-bag\"><strong class=\"ds-bag-title\">Dans le sac</strong><div class=\"ds-bag-item\"><span class=\"ds-bag-ico\"></span><span><b>Habillage pluie</b><small>Pluie dès maintenant</small></span></div></div>",
      "css": ".ds-bag{display:grid;gap:10px;padding:13px 14px 14px;border-radius:22px;background:var(--cream,#fdf6e3);border:1px solid var(--cream-line,#f1e2b6);font-family:Poppins,ui-rounded,system-ui,sans-serif}.ds-bag-title{font-size:.86rem;font-weight:600;color:var(--cream-ink,#6b5a1e)}.ds-bag-item{display:flex;align-items:center;gap:12px;font-size:.94rem;color:var(--ink,#1c1b22)}.ds-bag-item b{display:block;font-weight:600}.ds-bag-item small{font-size:.82rem;color:var(--cream-ink,#6b5a1e)}.ds-bag-ico{width:46px;height:46px;border-radius:15px;background:var(--card,#fff)}"
